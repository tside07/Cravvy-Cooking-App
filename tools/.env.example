# Copy to tools/.env — never commit real keys
#
# Supabase Dashboard → Project Settings → API:
#   - Project URL  → SUPABASE_URL
#   - service_role secret → SUPABASE_SERVICE_ROLE_KEY (NOT anon key)
#
# Tip: if Flutter already works, copy SUPABASE_URL from root .env and add service_role here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...paste_service_role_secret_here
