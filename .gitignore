# Miscellaneous
*.class
*.log
*.pyc
__pycache__/
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Desktop: auto-regenerated by `flutter pub get` (avoids checkout conflicts on Windows/macOS/Linux)
linux/flutter/generated_plugin_registrant.cc
linux/flutter/generated_plugin_registrant.h
linux/flutter/generated_plugins.cmake
macos/Flutter/GeneratedPluginRegistrant.swift
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Build outputs & signing material — chặn ở gốc phòng khi lỡ copy ra ngoài
# /build/ hoặc android/ (vd. để tiện tay chạy firebase_distribute.ps1).
*.apk
*.aab
*.ipa
*.jks
*.keystore
*.p12
*.mobileprovision
key.properties

# Cache của Firebase CLI (tạo ra khi chạy `firebase login`/`firebase deploy` cục bộ)
# firebase-debug.log đã khớp rule *.log ở đầu file, không cần lặp lại.
.firebase/

# Environment
.env
*.env
.env.local
.env.production

# Supabase
supabase/.branches
supabase/.temp

# Project docs / weekly progress (local only — not pushed)
/docs/
# Claude Code local memory (not part of the project)
memory/

# AI / editor tool folders (local only — not part of the project)
.claude/
.cursor/

# Recipe image-gen working set & scratch artifacts (ảnh đã upload lên Supabase; local only)
tools/_gen_images/
tools/_*.csv
tools/_*.html
tools/_*.json
data/seeds/*.bak.json
